{
  "expo": {
    "name": "MarshallsLawn",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "client",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.marshallslawn.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.marshallslawn.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e00a35",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Marshall's Lawn shares your crew's location with the dispatch office continuously while you are signed in, including when the app is in the background or your screen is locked, so dispatch can track crews live on the map and send the next job to the nearest crew.",
          "locationAlwaysPermission": "Marshall's Lawn shares your crew's location with the dispatch office continuously while you are signed in, including when the app is in the background or your screen is locked, so dispatch can track crews live on the map and send the next job to the nearest crew.",
          "locationWhenInUsePermission": "Marshall's Lawn shares your crew's location with the dispatch office so the office can see where your crew is working and route the next job to you.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Marshall's Lawn needs access to your photos so you can attach job site pictures.",
          "cameraPermission": "Marshall's Lawn needs camera access so you can take job site photos."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#e00a35"
        }
      ],
      [
        "./plugins/with-background-modes",
        {
          "modes": ["location"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc5e5926-753c-4e9d-a1e0-ea6b702012c2"
      }
    },
    "owner": "divstrong"
  }
}
