# Point the mobile app at your local Laravel server for dev login.
# EXPO_PUBLIC_* values are inlined at bundle time — restart Expo with a
# cleared cache after changing this:  npx expo start -c
#
# Pick the line that matches where the app runs, then comment out the others:
#
#   Android emulator (AVD):     http://10.0.2.2:8000/api
#   iOS simulator / web:        http://localhost:8000/api
#   Physical device (Expo Go):  http://<YOUR-LAN-IP>:8000/api   e.g. http://192.168.1.20:8000/api

EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
