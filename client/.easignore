# Files EAS Build should NOT upload.
#
# IMPORTANT: .easignore REPLACES .gitignore entirely — anything ignored there is
# uploaded unless repeated here. That is why this file re-lists build output and
# dependency folders that .gitignore already covers.
#
# Patterns are matched against the ARCHIVE root, which is the git repository
# root (marshallslawn/), not this directory. Anchored patterns like `/android`
# therefore miss `client/android`. Everything below is written to match at any
# depth so it works regardless.

# --- env files: never ship these in a build -----------------------------------
# Local dev URLs (e.g. EXPO_PUBLIC_API_URL=http://10.0.2.2…) must never be baked
# into a cloud build. Release builds fall back to PRODUCTION_API_URL in
# src/constants/config.ts.
.env
.env.*
.env*.local

# --- dependencies (reinstalled on the build worker) ---------------------------
node_modules/
vendor/

# --- generated native projects (EAS runs prebuild itself) ---------------------
android/
ios/

# --- the Laravel backend: nothing in it is used by a mobile build -------------
server/

# --- version control ----------------------------------------------------------
.git/

# --- Expo / bundler output ----------------------------------------------------
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# --- native build artifacts / signing -----------------------------------------
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
*.apk
*.aab
*.ipa

# --- misc ---------------------------------------------------------------------
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
*.tsbuildinfo
app-example
coverage/
