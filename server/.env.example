APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/New_York
APP_URL=http://localhost

# Allow the mobile app's passwordless dev role login on a deployed (non-local) build.
DEV_LOGIN_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Field app sign-in is passwordless (emailed one-time code). App Store reviewers
# can't read that mailbox, so this address accepts the fixed code below instead
# and its employee record is created on first use.
#
# BOTH must be set for the bypass to work, and both are empty by default. The
# code is a fixed, publicly documented string, so an enabled bypass is a
# credential anyone can use — set these for the review window, then clear them
# once the build is approved.
APP_REVIEW_EMAIL=
APP_REVIEW_CODE=
# Role the demo account is given (foreman is the role with background location).
APP_REVIEW_ROLE=foreman
# Crew whose jobs the demo account sees. Leave blank to auto-join the crew with
# the most upcoming jobs, so Jobs/Schedule are not empty for the reviewer.
APP_REVIEW_CREW_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=

# Twilio SMS (A2P 10DLC). Leave credentials blank to disable — TwilioService
# then logs instead of sending. TWILIO_NOTIFICATIONS_ENABLED is the master
# on/off for outbound customer SMS; individual events are toggled in
# Settings → Notifications. Enable TWILIO_DOUBLE_OPT_IN for A2P-compliant
# consent (customers must reply YES before any message is sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_NOTIFICATIONS_ENABLED=false
TWILIO_DOUBLE_OPT_IN=false

# On-the-fly translation of job details + chat for non-English field staff
# (issue #56). driver: openai (default), google, or null (off). Translations are
# cached per source string, so cost is one API call per unique phrase. With the
# openai driver, set OPENAI_KEY; with no key it safely falls back to English.
TRANSLATION_DRIVER=openai
OPENAI_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
GOOGLE_TRANSLATE_KEY=
